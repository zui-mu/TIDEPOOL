# Preserve project source Assets/.meta, Packages and ProjectSettings.
# In particular, do not ignore sources/, Development/, work/ or root Temp/.
# Already tracked historical files stay tracked even when a pattern below matches.

# ThinkRail workspace-local state (not project documentation)
/.thinkrail/

# Transient editor command/request channels; never replay on another machine.
/TidePool/Development/unity_hall_expansion/unity-command.txt
/TidePool/Development/unity_hall_expansion/dream-command.txt
/TidePool/Development/unity_monument/command.txt
/TidePool/Development/unity_pool_lighting/command.txt
